# GEMINI_API_KEY: Unused by CertBee client-side PDF workflow (kept for runtime compatibility).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / VITE_SITE_URL: Canonical production domain (no trailing slash).
# Example: https://certbee.app
APP_URL="MY_APP_URL"
VITE_SITE_URL=""

# Optional Search Console & Bing Webmaster verification tokens (content value only)
VITE_GSC_VERIFICATION=""
VITE_BING_VERIFICATION=""

# Optional privacy-preserving Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=""
# Set to "true" to require explicit localStorage consent ("certbee_analytics_consent=granted") before firing events
VITE_ANALYTICS_REQUIRE_CONSENT="false"
